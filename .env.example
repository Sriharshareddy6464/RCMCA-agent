POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_DB=road_intelligence
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
OSRM_HOST_PORT=5001
API_HOST_PORT=8001
AWS_REGION=ap-south-1
S3_BUCKET=
# CloudFront distribution URL for the private S3 evidence bucket (configured in Phase 4).
S3_PUBLIC_BASE_URL=
DATABASE_URL=postgresql://postgres:postgres_dev_only@postgis:5432/road_intelligence
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama-local
LLM_MODEL=qwen2.5:3b
LLM_PROVIDER=openai_compatible
VLLM_IMAGE_TAG=v0.11.2
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
VLLM_HOST_PORT=8002
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.82
VISION_MODEL_PATH=/models/road_damage.onnx
# Ordered classes for the included pothole starter; replace for another ONNX model.
VISION_CLASS_NAMES=["pothole"]
VISION_CONFIDENCE_THRESHOLD=0.35
VISION_NMS_THRESHOLD=0.45
VISION_SEVERITY_AREA_THRESHOLDS=0.01,0.03,0.08,0.2
VISION_WORKER_POLL_SECONDS=0.5
VISION_WORKER_RECLAIM_SECONDS=60
GHMC_FEED_URL=
PRAJAVANI_FEED_URL=
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=RCMCA-road-condition-monitor/0.2
MUNICIPAL_SYNC_INTERVAL_SECONDS=1800
